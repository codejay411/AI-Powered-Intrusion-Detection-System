# Database Configuration
DB_TYPE=sqlite
DB_PATH=data/ids.db
# For PostgreSQL (future):
# DB_TYPE=postgresql
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=ids_db
# DB_USER=ids_user
# DB_PASSWORD=your_password

# API Configuration
API_HOST=0.0.0.0
API_PORT=5000
API_SECRET_KEY=change-this-secret-key-in-production

# Dashboard Configuration
DASHBOARD_PORT=8501
DASHBOARD_TITLE=AI-Powered IDS

# ML Model Configuration
MODEL_PATH=models/
MODEL_RETRAIN_INTERVAL_HOURS=24

# Threat Intelligence
VIRUSTOTAL_API_KEY=your_vt_api_key
ABUSEIPDB_API_KEY=your_abuseipdb_key

# Alert Configuration
ALERT_RETENTION_DAYS=90
MAX_ALERTS_PER_QUERY=1000

# Logging
LOG_LEVEL=INFO
LOG_PATH=logs/

# GeoIP Database
GEOIP_DB_PATH=data/GeoLite2-City.mmdb
